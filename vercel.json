{
  "version": 2,
  "builds": [
    {
      "src": "disaster_dashboard/disaster_dashboard/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb"
      }
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/media/(.*)",
      "dest": "/media/$1"
    },
    {
      "src": "/(.*)",
      "dest": "disaster_dashboard/disaster_dashboard/wsgi.py"
    }
  ],
  "env": {
    "DJANGO_SETTINGS_MODULE": "disaster_dashboard.settings"
  },
  "functions": {
    "disaster_dashboard/disaster_dashboard/wsgi.py": {
      "runtime": "python3.9"
    }
  }
}
