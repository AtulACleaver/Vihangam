{
  "version": 2,
  "builds": [
    {
      "src": "disaster_dashboard/disaster_dashboard/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "runtime": "python3.9",
        "installCommand": "pip install -r requirements-vercel.txt"
      }
    },
    {
      "src": "build_files.sh",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "staticfiles"
      }
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/staticfiles/$1"
    },
    {
      "src": "/media/(.*)",
      "dest": "/media/$1"
    },
    {
      "src": "/(.*)",
      "dest": "disaster_dashboard/disaster_dashboard/wsgi.py"
    }
  ],
  "env": {
    "DJANGO_SETTINGS_MODULE": "disaster_dashboard.disaster_dashboard.settings",
    "DISABLE_COLLECTSTATIC": "1"
  }
}
